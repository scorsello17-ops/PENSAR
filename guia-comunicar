<style>
:root{
  --ink:#1a1a20;--ink2:#3a3848;--muted:#8080a0;--bg:#f2f0ec;--white:#fdfcfb;
  --border:#ddd8d0;--border2:#c8c0b8;
  --v1:#4a1a8a;--v1l:#edeaff;--v1b:#c0a8f8;   /* púrpura – QUERY */
  --v2:#0f5c3a;--v2l:#e4f5ee;--v2b:#7ecaa8;   /* verde – fórmulas */
  --v3:#7a4000;--v3l:#fff2e8;--v3b:#f0b880;   /* naranja – dashboard */
  --v4:#1a3a6a;--v4l:#e6eef8;--v4b:#90b0d8;   /* azul – storytelling */
  --red:#c0202a;--redl:#fce8e8;--redb:#e08090;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:'Outfit',sans-serif;font-size:15px;line-height:1.65;min-height:100vh}

.hero{background:linear-gradient(135deg,#1a0a30 0%,#0a1a20 100%);padding:52px 48px 40px;position:relative;overflow:hidden}
.hero::before{content:'COMUNICAR';position:absolute;right:-10px;top:-20px;font-family:'Playfair Display',serif;font-size:160px;font-weight:900;color:rgba(255,255,255,0.04);line-height:1;pointer-events:none}
.hero-eyebrow{font-family:'JetBrains Mono',monospace;font-size:.68rem;color:rgba(255,255,255,0.4);letter-spacing:.18em;text-transform:uppercase;margin-bottom:14px;display:flex;align-items:center;gap:10px}
.hero-eyebrow::before{content:'';width:24px;height:1px;background:rgba(255,255,255,0.25)}
.hero-title{font-family:'Playfair Display',serif;font-size:clamp(2.4rem,5vw,3.6rem);font-weight:900;color:#fff;line-height:1.08;letter-spacing:-.01em;margin-bottom:14px}
.hero-title em{color:#d0b8ff;font-style:italic}
.hero-desc{font-size:.95rem;color:rgba(255,255,255,0.5);max-width:580px;line-height:1.7;margin-bottom:32px}
.hero-pills{display:flex;flex-wrap:wrap;gap:8px}
.hero-pill{font-family:'JetBrains Mono',monospace;font-size:.65rem;padding:5px 12px;border-radius:20px;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.13);color:rgba(255,255,255,0.55);cursor:pointer;transition:all .2s}
.hero-pill:hover,.hero-pill.active{background:rgba(208,184,255,0.15);color:#d0b8ff;border-color:rgba(208,184,255,0.3)}

.tab-nav{display:flex;background:var(--white);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:50;overflow-x:auto}
.tab-btn{padding:15px 22px;font-family:'Outfit',sans-serif;font-weight:600;font-size:.75rem;letter-spacing:.04em;text-transform:uppercase;background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;color:var(--muted);transition:all .2s;white-space:nowrap}
.tab-btn:hover{color:var(--ink)}
.tab-btn.active{color:var(--v1);border-bottom-color:var(--v1)}

.section{display:none;max-width:880px;margin:0 auto;padding:44px 28px 80px}
.section.active{display:block;animation:fadeUp .3s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

.sec-label{font-family:'JetBrains Mono',monospace;font-size:.66rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.sec-title{font-family:'Playfair Display',serif;font-size:1.7rem;font-weight:700;color:var(--ink);line-height:1.2;margin-bottom:6px}
.sec-sub{font-size:.88rem;color:var(--muted);margin-bottom:32px;line-height:1.6}

.quote-box{background:linear-gradient(135deg,#1a0a30,#0a1a20);color:#fff;border-radius:12px;padding:20px 24px;margin-bottom:22px;position:relative;overflow:hidden}
.quote-box::before{content:'"';position:absolute;right:16px;top:-8px;font-family:'Playfair Display',serif;font-size:80px;color:rgba(255,255,255,0.06);line-height:1}
.quote-label{font-family:'JetBrains Mono',monospace;font-size:.6rem;color:#d0b8ff;letter-spacing:.14em;text-transform:uppercase;margin-bottom:8px}
.quote-text{font-size:.9rem;line-height:1.7;color:rgba(255,255,255,0.82);position:relative;z-index:1}
.quote-text strong{color:#d0b8ff;font-weight:600}

.cc{background:var(--white);border:1px solid var(--border);border-radius:14px;padding:22px 24px;margin-bottom:16px;border-left:4px solid}
.cc1{border-left-color:var(--v1)}.cc2{border-left-color:var(--v2)}.cc3{border-left-color:var(--v3)}.cc4{border-left-color:var(--v4)}
.cc-header{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px}
.cc-title{font-weight:700;font-size:.95rem;color:var(--ink);line-height:1.3}
.cc-badge{font-family:'JetBrains Mono',monospace;font-size:.6rem;font-weight:600;padding:3px 9px;border-radius:4px;white-space:nowrap;flex-shrink:0;letter-spacing:.06em;text-transform:uppercase;margin-top:2px}
.b1{background:var(--v1l);color:var(--v1)}.b2{background:var(--v2l);color:var(--v2)}.b3{background:var(--v3l);color:var(--v3)}.b4{background:var(--v4l);color:var(--v4)}
.cc-body{font-size:.86rem;color:var(--ink2);line-height:1.72}
.cc-body p+p{margin-top:8px}.cc-body ul{padding-left:18px;margin-top:6px}.cc-body li{margin-bottom:5px}
.cc-body strong{color:var(--ink);font-weight:600}.cc-body em{color:var(--v1);font-style:italic}

.fblock{background:#0d0820;border-radius:10px;padding:16px 20px;font-family:'JetBrains Mono',monospace;font-size:.78rem;line-height:1.95;color:#d0c0f0;margin:12px 0;overflow-x:auto;border-left:3px solid var(--v1)}
.fblock.fb2{border-left-color:var(--v2);background:#0d1a0d;color:#c0e8d0}.fblock.fb3{border-left-color:var(--v3);background:#1a0d00;color:#f0d0a0}
.fn{color:#7ec8f0}.kw{color:#ff7070}.str{color:#f0a06a}.num{color:#a3e635}.cm{color:#5050a0;font-style:italic}.acc{color:#d0b8ff;font-weight:700}.hl{color:#ffd080}.kc{color:#ff9060}

.tip{border-radius:8px;padding:12px 16px;font-size:.82rem;line-height:1.65;margin-top:12px;display:flex;gap:8px;align-items:flex-start}
.tip-warn{background:#fff8e0;border:1px solid #e8d800;color:#5a4800}.tip-warn::before{content:'⚠️';flex-shrink:0}
.tip-ok{background:var(--v2l);border:1px solid var(--v2b);color:#0a3a20}.tip-ok::before{content:'✓';flex-shrink:0;font-weight:700;color:var(--v2)}
.tip-quote{background:#0d0820;color:rgba(255,255,255,.8);border:1px solid rgba(208,184,255,.2)}.tip-quote::before{content:'💬';flex-shrink:0}
.tip strong{font-weight:600}

.tbl-wrap{background:var(--white);border:1px solid var(--border);border-radius:12px;overflow:hidden;overflow-x:auto;margin:14px 0}
.dtbl{width:100%;border-collapse:collapse;font-size:.82rem}
.dtbl th{padding:10px 14px;font-family:'JetBrains Mono',monospace;font-size:.66rem;font-weight:600;color:var(--muted);text-align:left;border-bottom:1px solid var(--border);background:var(--bg);text-transform:uppercase;letter-spacing:.06em}
.dtbl td{padding:10px 14px;border-bottom:1px solid rgba(0,0,0,.05);color:var(--ink2);line-height:1.5}
.dtbl tr:last-child td{border-bottom:none}.dtbl tr:hover td{background:var(--bg)}
.dtbl .key{font-family:'JetBrains Mono',monospace;font-size:.76rem;font-weight:600}
.c1{color:var(--v1)}.c2{color:var(--v2)}.c3{color:var(--v3)}.c4{color:var(--v4)}

.divider{display:flex;align-items:center;gap:12px;margin:28px 0}
.divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--border)}
.divider span{font-family:'JetBrains Mono',monospace;font-size:.64rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;white-space:nowrap}

/* QUERY visual builder */
.query-builder{background:#0d0820;border-radius:12px;padding:20px 22px;margin:14px 0;font-family:'JetBrains Mono',monospace;font-size:.82rem}
.qb-row{display:flex;align-items:flex-start;gap:12px;margin-bottom:10px}
.qb-row:last-child{margin-bottom:0}
.qb-clause{color:#ff9060;font-weight:700;min-width:80px;flex-shrink:0;line-height:1.6}
.qb-content{color:#d0c0f0;line-height:1.6}
.qb-desc{font-family:'Outfit',sans-serif;font-size:.75rem;color:rgba(255,255,255,.4);font-style:italic;margin-left:12px}
.qb-col{color:#a3e635}.qb-op{color:#7ec8f0}.qb-val{color:#f0a06a}

/* SQL vs QUERY comparator */
.compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:14px 0}
.cmp-card{border-radius:10px;padding:16px 18px;border:1px solid}
.cmp-q{background:#0d0820;border-color:rgba(208,184,255,.25)}
.cmp-s{background:#0d1a0d;border-color:rgba(160,232,160,.2)}
.cmp-label{font-family:'JetBrains Mono',monospace;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px}
.cmp-q .cmp-label{color:#d0b8ff}.cmp-s .cmp-label{color:#a0e8c0}
.cmp-code{font-family:'JetBrains Mono',monospace;font-size:.74rem;line-height:1.9;color:rgba(255,255,255,.8)}

/* Cheatsheet rows */
.cs-wrap{background:var(--white);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.cs-row{display:grid;grid-template-columns:190px 1fr;border-bottom:1px solid var(--border)}
.cs-row:last-child{border-bottom:none}
.cs-term{padding:13px 16px;font-family:'JetBrains Mono',monospace;font-size:.78rem;font-weight:700;color:var(--v1);background:var(--bg);border-right:1px solid var(--border);display:flex;align-items:flex-start}
.cs-def{padding:13px 18px;font-size:.83rem;color:var(--ink2);line-height:1.6}

/* Flashcards */
.fc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(252px,1fr));gap:14px}
.fc{perspective:600px;height:158px;cursor:pointer}
.fc-inner{position:relative;width:100%;height:100%;transition:transform .45s;transform-style:preserve-3d}
.fc.flipped .fc-inner{transform:rotateY(180deg)}
.fc-front,.fc-back{position:absolute;inset:0;border-radius:12px;padding:16px 18px;backface-visibility:hidden;display:flex;flex-direction:column;justify-content:space-between}
.fc-front{background:var(--white);border:1px solid var(--border)}
.fc-back{background:linear-gradient(135deg,#1a0a30,#0a1a20);transform:rotateY(180deg)}
.fc-q{font-size:.84rem;color:var(--ink2);line-height:1.55;font-weight:500}
.fc-hint{font-family:'JetBrains Mono',monospace;font-size:.6rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.fc-a{font-size:.81rem;line-height:1.6;color:rgba(255,255,255,.88)}
.fc-a strong{color:#d0b8ff}
.fc-cat{font-family:'JetBrains Mono',monospace;font-size:.6rem;color:rgba(255,255,255,.35);text-transform:uppercase;letter-spacing:.08em}

/* Quiz */
.qscore-bar{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:16px 22px;display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:10px}
.qscore-num{font-family:'Playfair Display',serif;font-size:2.2rem;font-weight:700;color:var(--red);line-height:1}
.qscore-lbl{font-family:'JetBrains Mono',monospace;font-size:.62rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.q-box{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:20px 22px;margin-bottom:16px}
.q-num{font-family:'JetBrains Mono',monospace;font-size:.63rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px}
.q-text{font-size:.92rem;color:var(--ink);line-height:1.65;margin-bottom:14px;font-weight:500}
.q-opts{display:flex;flex-direction:column;gap:8px}
.q-opt{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:11px 14px;cursor:pointer;font-size:.84rem;color:var(--ink2);text-align:left;transition:all .15s;display:flex;align-items:flex-start;gap:10px;line-height:1.5}
.q-opt:hover:not(:disabled){background:#ece8e0;border-color:var(--border2)}
.q-opt:disabled{cursor:default}
.q-opt.correct{border-color:var(--v2);background:var(--v2l);color:#0a3a20}
.q-opt.wrong{border-color:var(--red);background:var(--redl);color:#5a1010}
.q-opt .oid{width:22px;height:22px;border-radius:50%;background:var(--border);display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:.64rem;font-weight:700;flex-shrink:0;color:var(--muted)}
.q-opt.correct .oid{background:var(--v2);color:#fff}
.q-fb{border-radius:8px;padding:10px 14px;font-size:.82rem;line-height:1.6;display:none;margin-top:10px}
.q-fb.show{display:block}
.q-fb.ok{background:var(--v2l);border:1px solid var(--v2b);color:#0a3a20}
.q-fb.bad{background:var(--redl);border:1px solid var(--redb);color:#5a1010}

.chip-row{display:flex;flex-wrap:wrap;gap:7px;margin:14px 0}
.chip{font-family:'JetBrains Mono',monospace;font-size:.64rem;padding:3px 10px;border-radius:20px;border:1px solid;letter-spacing:.04em}
.ch1{background:var(--v1l);color:var(--v1);border-color:var(--v1b)}.ch2{background:var(--v2l);color:var(--v2);border-color:var(--v2b)}
.ch3{background:var(--v3l);color:var(--v3);border-color:var(--v3b)}.ch4{background:var(--v4l);color:var(--v4);border-color:var(--v4b)}
.chk{background:#f0ede8;color:#444;border-color:var(--border2)}

.btn-sm{font-family:'Outfit',sans-serif;font-weight:600;font-size:.72rem;letter-spacing:.04em;text-transform:uppercase;padding:8px 16px;border-radius:7px;cursor:pointer;border:1px solid;transition:all .15s}
.btn-sec{background:transparent;color:var(--muted);border-color:var(--border)}.btn-sec:hover{border-color:var(--border2);color:var(--ink)}

@media(max-width:640px){
  .hero{padding:36px 22px 28px}.section{padding:30px 16px 60px}
  .compare-grid{grid-template-columns:1fr}.cs-row{grid-template-columns:1fr}
  .cs-term{border-right:none;border-bottom:1px solid var(--border)}
  .fc-grid{grid-template-columns:1fr}.tab-btn{padding:14px 14px;font-size:.68rem}
}
</style>
</head>
<body>

<div class="hero">
  <div class="hero-eyebrow">Unicorn Academy · Sesión 3 · Última sesión del módulo</div>
  <h1 class="hero-title">COMUNICAR —<br><em>Contar</em> la historia</h1>
  <p class="hero-desc">Sesión práctica intensa: métricas de Procesos e Innovación, QUERY (= SQL en Sheets), Dashboard BSC con gráficos y Storytelling para el director financiero.</p>
  <div class="hero-pills">
    <span class="hero-pill" onclick="showTab('resumen',this)">Resumen</span>
    <span class="hero-pill active" onclick="showTab('conceptos',this)">Conceptos</span>

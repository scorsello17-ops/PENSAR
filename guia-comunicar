    <span class="hero-pill" onclick="showTab('quiz',this)">Quiz</span>
  </div>
</div>

<nav class="tab-nav">
  <button class="tab-btn" onclick="showTab('resumen',this)">📋 Resumen</button>
  <button class="tab-btn active" onclick="showTab('conceptos',this)">📚 Conceptos</button>
  <button class="tab-btn" onclick="showTab('query',this)">🔍 QUERY</button>
  <button class="tab-btn" onclick="showTab('cheatsheet',this)">⚡ Cheatsheet</button>
  <button class="tab-btn" onclick="showTab('flashcards',this)">🃏 Flashcards</button>
  <button class="tab-btn" onclick="showTab('quiz',this)">✏️ Quiz</button>
